# ── Neon DB (read by Prisma in the dashboard) ──────────────────────────────
# Pooled DSN — used at runtime by Prisma Client
DATABASE_URL=postgres://USER:PASS@HOST.neon.tech/DBNAME?sslmode=require
# Direct (non-pooled) DSN — used by `prisma migrate` / `prisma db push`
DATABASE_URL_UNPOOLED=postgres://USER:PASS@HOST-pooler.neon.tech/DBNAME?sslmode=require

# ── Voice service backend ──────────────────────────────────────────────────
# URL where the Python voice-service is reachable (Hostinger Coolify host).
# In local dev: http://localhost:8000
VOICE_SERVICE_URL=http://localhost:8000

# Bearer token shared with the voice-service (must match its VOICE_SERVICE_TOKEN).
# Generate with: `openssl rand -base64 32`
VOICE_SERVICE_TOKEN=replace-with-secure-random-32-bytes-base64

# ── LiveKit Cloud (only kept for client SDK usage in the demo widget) ──────
# The browser fetches its JWT from /api/demo/proxy → voice-service /api/demo/token,
# so these are NOT required at build time. Provided here for parity if you ever
# add a browser SDK feature that needs the URL directly.
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
