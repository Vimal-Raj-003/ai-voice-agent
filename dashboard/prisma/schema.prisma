// =============================================================================
//  Rapid X AI — Voice Agent Platform (Vapi-style data model)
//  Database: Neon Postgres
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// =============================================================================
//  ENUMS
// =============================================================================

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  QUEUED
  RINGING
  IN_PROGRESS
  COMPLETED
  FAILED
  NO_ANSWER
  BUSY
  CANCELED
}

enum EndedReason {
  CUSTOMER_HANGUP
  ASSISTANT_HANGUP
  TRANSFERRED
  PIPELINE_ERROR
  SILENCE_TIMEOUT
  EXCEEDED_MAX_DURATION
  VOICEMAIL
  NO_ANSWER
  BUSY
  REJECTED
  UNKNOWN
}

enum TranscriptRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum LlmProvider {
  OPENAI
  GROQ
  OPENROUTER
  ANTHROPIC
  CUSTOM
}

enum TtsProvider {
  OPENAI
  DEEPGRAM
  SARVAM
  CARTESIA
  ELEVENLABS
}

enum SttProvider {
  DEEPGRAM
  OPENAI
  SARVAM
}

enum TrunkType {
  INBOUND
  OUTBOUND
}

enum CampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

enum CampaignTargetStatus {
  PENDING
  DISPATCHED
  COMPLETED
  FAILED
  SKIPPED
}

enum WebhookEvent {
  CALL_STARTED
  CALL_ENDED
  CALL_FAILED
  TRANSCRIPT_UPDATE
  TRANSFER_INITIATED
}

enum CallOutcome {
  BOOKED
  NOT_INTERESTED
  WRONG_NUMBER
  VOICEMAIL
  NO_ANSWER
  CALLBACK_REQUESTED
  TRANSFERRED
  FAILED
  COMPLETED
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ScheduleType {
  ONCE
  DAILY
  WEEKDAYS
}

enum RateKind {
  LLM_INPUT_MTOK // USD per 1,000,000 input tokens
  LLM_OUTPUT_MTOK // USD per 1,000,000 output tokens
  STT_MINUTE // USD per minute of audio transcribed
  TTS_KCHARS // USD per 1,000 characters synthesized
  TELEPHONY_MINUTE // USD per minute of telephony egress
}

enum RateSource {
  OPENROUTER // auto-fetched from openrouter.ai/api/v1/models
  MANUAL // edited by an admin in the dashboard
  DEFAULT // seeded by code on first run
}

enum SpeechSensitivity {
  LOW    // long silence threshold — patient agent, fewer interruptions
  MEDIUM // balanced (default)
  HIGH   // shorter threshold — quicker agent, may interrupt
}

enum ErrorLevel {
  INFO
  WARNING
  ERROR
  CRITICAL
}

// =============================================================================
//  TENANCY (Org / User / API Key)
// =============================================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  assistants   Assistant[]
  phoneNumbers PhoneNumber[]
  sipTrunks    SipTrunk[]
  calls        Call[]
  campaigns    Campaign[]
  tools        Tool[]
  apiKeys      ApiKey[]
  webhooks     Webhook[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  passwordHash   String?
  organizationId String
  role           String   @default("member") // owner | admin | member
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("users")
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyHash        String    @unique
  prefix         String // first 8 chars for display ("rk_xxxxxx...")
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

// =============================================================================
//  ASSISTANT  (the AI voice agent — equivalent of Vapi "Assistant")
// =============================================================================

model Assistant {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  description    String?

  // Persona
  systemPrompt   String  @db.Text
  firstMessage   String? @db.Text
  endCallMessage String? @db.Text

  // LLM
  llmProvider LlmProvider @default(OPENAI)
  llmModel    String      @default("gpt-4o-mini")
  temperature Float       @default(0.7)
  maxTokens   Int?

  // STT
  sttProvider SttProvider @default(DEEPGRAM)
  sttModel    String      @default("nova-2")
  sttLanguage String      @default("en")

  // TTS
  ttsProvider TtsProvider @default(DEEPGRAM)
  ttsModel    String?
  voiceId     String?

  // Behavior
  silenceTimeoutSeconds Int      @default(30)
  maxDurationSeconds    Int      @default(1800)
  endCallPhrases        String[] @default([])
  backgroundSound       String?

  // Recording / Privacy
  recordingEnabled Boolean @default(true)
  hipaaEnabled     Boolean @default(false)

  // ── Call accuracy & speech tuning (industry-standard knobs) ──────────────
  // endOfSpeechSensitivity: how aggressively VAD declares the user has
  //   stopped speaking. LOW = wait longer (avoids interrupting), HIGH = react
  //   faster (snappier turn-taking, more interruptions risk).
  // interruptionThresholdMs: minimum continuous user speech (ms) required to
  //   stop the agent mid-utterance. Higher = ignores coughs, "yeah"s.
  // backgroundDenoising: enable LiveKit BVCTelephony noise cancellation.
  // voicemailDetection: detect answering-machine tone and leave a short
  //   message instead of treating the silence as an awkward pause.
  // confidenceThresholdPct: if STT confidence < this %, agent asks the user
  //   to repeat. 0 = never ask. Industry sweet spot is ~55-65.
  // hallucinationGuard: auto-append a "do not invent information" clause to
  //   the system prompt. Reduces fabricated facts noticeably with LLMs.
  // minPauseMs: floor on how soon the agent can respond after the user
  //   stops talking — prevents "trampling" the customer.
  endOfSpeechSensitivity SpeechSensitivity @default(LOW)
  interruptionThresholdMs Int              @default(150)
  backgroundDenoising     Boolean          @default(true)
  voicemailDetection      Boolean          @default(false)
  voicemailMessage        String?          @db.Text
  confidenceThresholdPct  Int              @default(0)
  hallucinationGuard      Boolean          @default(true)
  minPauseMs              Int              @default(200)

  // Misc
  metadata Json?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneNumbers PhoneNumber[]
  calls        Call[]
  campaigns    Campaign[]
  tools        AssistantTool[]

  @@index([organizationId])
  @@map("assistants")
}

// =============================================================================
//  TELEPHONY  (SIP Trunks + Phone Numbers)
// =============================================================================

model SipTrunk {
  id             String    @id @default(cuid())
  organizationId String
  provider       String    @default("vobiz") // vobiz | twilio | telnyx
  type           TrunkType
  name           String
  livekitTrunkId String    @unique // LiveKit-side trunk identifier
  sipDomain      String?
  sipUsername    String?
  sipPassword    String? // encrypted at rest in production
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  numbers      PhoneNumber[]

  @@index([organizationId])
  @@map("sip_trunks")
}

model PhoneNumber {
  id             String   @id @default(cuid())
  organizationId String
  number         String   @unique // E.164 format e.g. +918065480036
  provider       String   @default("vobiz")
  trunkId        String?
  assistantId    String? // assistant that picks up inbound calls on this number
  label          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trunk        SipTrunk?    @relation(fields: [trunkId], references: [id], onDelete: SetNull)
  assistant    Assistant?   @relation(fields: [assistantId], references: [id], onDelete: SetNull)
  calls        Call[]

  @@index([organizationId])
  @@index([assistantId])
  @@map("phone_numbers")
}

// =============================================================================
//  CALL  (one row per attempted/completed call)
// =============================================================================

model Call {
  id             String  @id @default(cuid())
  organizationId String
  assistantId    String?
  phoneNumberId  String? // owned phone number this call routed through
  campaignId     String?

  // Telephony identifiers
  livekitRoomName String? @unique
  livekitCallId   String? @unique
  sipCallId       String? @unique
  dispatchId      String?

  // Parties
  fromNumber  String
  toNumber    String
  direction   CallDirection
  status      CallStatus    @default(QUEUED)
  endedReason EndedReason?

  // Timing
  startedAt       DateTime?
  answeredAt      DateTime?
  endedAt         DateTime?
  durationSeconds Int?

  // Cost ($ — six decimals). Snapshot computed at the time of the call using
  // the rates current then; the dashboard recomputes a live cost from the
  // usage columns below + the ProviderRate table on every render.
  costUsd Decimal? @db.Decimal(10, 6)

  // Usage breakdown — captured on shutdown so cost can be (re)computed
  // against current rates. Nullable because legacy rows predate this fields.
  llmInputTokens    Int?    @map("llm_input_tokens")
  llmOutputTokens   Int?    @map("llm_output_tokens")
  llmProviderUsed   String? @map("llm_provider_used") // "openai" | "groq" | "anthropic" | "google"
  llmSkuUsed        String? @map("llm_sku_used") // "gpt-4o-mini" | …
  sttSeconds        Int?    @map("stt_seconds")
  sttProviderUsed   String? @map("stt_provider_used") // "deepgram" | "sarvam"
  sttSkuUsed        String? @map("stt_sku_used") // "nova-3" | …
  ttsChars          Int?    @map("tts_chars")
  ttsProviderUsed   String? @map("tts_provider_used") // "elevenlabs" | "cartesia" | …
  ttsSkuUsed        String? @map("tts_sku_used")
  telephonyProvider String? @map("telephony_provider") // "vobiz" | "twilio"

  // Recording / artifacts
  recordingUrl String?
  summary      String? @db.Text

  // OutboundAI: outcome / sentiment / notes
  outcome             CallOutcome?
  reason              String?
  sentiment           String?
  interruptCount      Int          @default(0) @map("interrupt_count")
  wasBooked           Boolean      @default(false) @map("was_booked")
  notes               String?
  callerHistoryLoaded Boolean      @default(false) @map("caller_history_loaded")

  // Override snapshot (what config the call actually ran with, captured at dispatch time)
  modelProviderUsed String?
  voiceUsed         String?
  promptOverride    String? @db.Text

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assistant         Assistant?          @relation(fields: [assistantId], references: [id], onDelete: SetNull)
  phoneNumber       PhoneNumber?        @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  campaign          Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  transcript        TranscriptMessage[]
  toolInvocations   ToolInvocation[]
  webhookDeliveries WebhookDelivery[]

  @@index([organizationId, createdAt])
  @@index([assistantId])
  @@index([campaignId])
  @@index([status])
  @@index([toNumber])
  @@index([toNumber, createdAt])
  @@map("calls")
}

model TranscriptMessage {
  id        String         @id @default(cuid())
  callId    String
  role      TranscriptRole
  content   String         @db.Text
  timestamp DateTime       @default(now())
  // Optional rich data (e.g. tool args/results)
  data      Json?

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, timestamp])
  @@map("transcript_messages")
}

// =============================================================================
//  CAMPAIGN  (bulk dialer)
// =============================================================================

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  assistantId    String?
  name           String
  prompt         String?        @db.Text
  status         CampaignStatus @default(DRAFT)

  totalTargets      Int @default(0)
  dispatchedTargets Int @default(0)
  failedTargets     Int @default(0)
  completedTargets  Int @default(0)

  scheduleType     ScheduleType?
  scheduleTime     String? // "HH:MM" 24h IST
  callDelaySeconds Int           @default(3)
  agentProfileId   String?
  lastRunAt        DateTime?

  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assistant    Assistant?       @relation(fields: [assistantId], references: [id], onDelete: SetNull)
  targets      CampaignTarget[]
  calls        Call[]

  @@index([organizationId])
  @@map("campaigns")
}

model CampaignTarget {
  id           String               @id @default(cuid())
  campaignId   String
  phoneNumber  String
  status       CampaignTargetStatus @default(PENDING)
  callId       String?
  leadName     String?
  dispatchId   String?
  dispatchedAt DateTime?
  attempts     Int                  @default(0)
  lastError    String?              @db.Text
  variables    Json? // per-target template vars
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@map("campaign_targets")
}

// =============================================================================
//  TOOLS (function calling)
// =============================================================================

model Tool {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  // OpenAI-style function schema (JSON Schema)
  parameters     Json
  // Where to send the call — webhook URL OR built-in handler name (e.g. "transfer_call")
  serverUrl      String?
  serverSecret   String?
  builtin        String?
  // ── Custom HTTP tool runtime (Feature Pack 3 / Task 5) ─────────────────
  // kind = "HTTP" → at agent boot, an llm.function_tool wrapper makes the
  //   configured request when the LLM invokes this tool.
  // kind = "BUILTIN" → name maps to a hard-coded handler in tools.py (the
  //   existing 9 tools). Default for legacy rows.
  kind           String   @default("HTTP")
  httpMethod     String?  @default("POST") // GET | POST | PUT | DELETE
  httpUrl        String? // template — supports {arg} substitution from LLM args
  httpHeaders    Json? // {"Authorization": "Bearer xxx"}
  timeoutSeconds Int      @default(15)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assistants   AssistantTool[]
  invocations  ToolInvocation[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("tools")
}

model AssistantTool {
  assistantId String
  toolId      String
  assistant   Assistant @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  tool        Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@id([assistantId, toolId])
  @@map("assistant_tools")
}

model ToolInvocation {
  id         String   @id @default(cuid())
  callId     String
  toolId     String?
  toolName   String
  arguments  Json?
  result     Json?
  error      String?  @db.Text
  durationMs Int?
  createdAt  DateTime @default(now())

  call Call  @relation(fields: [callId], references: [id], onDelete: Cascade)
  tool Tool? @relation(fields: [toolId], references: [id], onDelete: SetNull)

  @@index([callId])
  @@map("tool_invocations")
}

// =============================================================================
//  WEBHOOKS (server events to external systems)
// =============================================================================

model Webhook {
  id             String         @id @default(cuid())
  organizationId String
  url            String
  secret         String?
  events         WebhookEvent[]
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String       @id @default(cuid())
  webhookId    String
  callId       String?
  event        WebhookEvent
  payload      Json
  responseCode Int?
  responseBody String?      @db.Text
  attempts     Int          @default(1)
  succeededAt  DateTime?
  createdAt    DateTime     @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  call    Call?   @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

// =============================================================================
//  OUTBOUNDAI — AgentProfile
// =============================================================================

model AgentProfile {
  id           String   @id @default(cuid())
  name         String
  voice        String   @default("Aoede")
  model        String   @default("gemini-3.1-flash-live-preview")
  systemPrompt String?  @map("system_prompt")
  enabledTools String   @default("[]") @map("enabled_tools")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isDefault])
  @@map("agent_profiles")
}

// =============================================================================
//  OUTBOUNDAI — Contacts / ContactMemory / Appointments
// =============================================================================

model Contact {
  id          String    @id @default(cuid())
  phoneNumber String    @unique @map("phone_number")
  name        String?
  email       String?
  notes       String?
  tags        String    @default("[]")
  totalCalls  Int       @default(0) @map("total_calls")
  lastCallAt  DateTime? @map("last_call_at")
  lastOutcome String?   @map("last_outcome")
  isBooked    Boolean   @default(false) @map("is_booked")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  memory       ContactMemory[]
  appointments Appointment[]

  @@map("contacts")
}

model ContactMemory {
  id          String   @id @default(cuid())
  phoneNumber String   @map("phone_number")
  insight     String
  createdAt   DateTime @default(now()) @map("created_at")

  contact Contact? @relation(fields: [phoneNumber], references: [phoneNumber], onDelete: Cascade)

  @@index([phoneNumber, createdAt])
  @@map("contact_memory")
}

model Appointment {
  id               String            @id @default(cuid())
  bookingId        String            @unique @map("booking_id")
  name             String
  phoneNumber      String            @map("phone_number")
  email            String?
  date             String
  time             String
  service          String
  status           AppointmentStatus @default(BOOKED)
  calcomBookingUid String?           @map("calcom_booking_uid")
  gcalEventId      String?           @map("gcal_event_id")
  notes            String?
  createdAt        DateTime          @default(now()) @map("created_at")

  contact Contact? @relation(fields: [phoneNumber], references: [phoneNumber])

  @@index([date, time])
  @@index([phoneNumber])
  @@map("appointments")
}

// =============================================================================
//  OUTBOUNDAI — Settings / ErrorLogs / ActiveCalls
// =============================================================================

model Setting {
  key         String   @id
  value       String
  isSensitive Boolean  @default(false) @map("is_sensitive")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model ErrorLog {
  id        String     @id @default(cuid())
  source    String
  level     ErrorLevel @default(ERROR)
  message   String
  detail    String?
  timestamp DateTime   @default(now())

  @@index([timestamp])
  @@index([source, level])
  @@map("error_logs")
}

model ActiveCall {
  roomId      String   @id @map("room_id")
  phoneNumber String?  @map("phone_number")
  callerName  String?  @map("caller_name")
  status      String   @default("ringing")
  startedAt   DateTime @default(now()) @map("started_at")
  lastUpdated DateTime @default(now()) @updatedAt @map("last_updated")

  @@map("active_calls")
}

// =============================================================================
//  PROVIDER RATES — billing rates per (provider, sku, kind)
//
//  Cost is COMPUTED at query time as Call.usage × current ProviderRate, never
//  stored on the Call row alone. That way historical calls move with rate
//  changes (e.g. when OpenAI cuts gpt-4o-mini prices, every existing call's
//  reported cost drops to match — exactly what an accurate cost dashboard
//  needs).
//
//  Source = OPENROUTER for LLM rates auto-refreshed from the openrouter.ai
//  free public API every 3 hours; MANUAL for STT/TTS/telephony where no
//  public pricing API exists; DEFAULT for the seeded values that ship with
//  the code on first boot.
// =============================================================================

model ProviderRate {
  id             String     @id @default(cuid())
  provider       String // "openai" | "groq" | "anthropic" | "google" | "deepgram" | "sarvam" | "elevenlabs" | "cartesia" | "vobiz"
  sku            String // "gpt-4o-mini" | "llama-3.3-70b-versatile" | "nova-3" | "turbo-v2-5" | "outbound" | …
  kind           RateKind
  rateUsd        Decimal    @db.Decimal(14, 8)
  source         RateSource @default(MANUAL)
  lastVerifiedAt DateTime   @default(now()) @map("last_verified_at")
  notes          String?
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@unique([provider, sku, kind])
  @@index([provider, kind])
  @@map("provider_rates")
}
